<mxfile host="app.diagrams.net" agent="ppr-handoff" version="24.7.7">
  <diagram name="PPR data preparation" id="ppr-dm">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1"
      arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="1556" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <UserObject label="&lt;b&gt;TUMOR PROCUREMENTS&lt;/b&gt;&lt;br/&gt;&lt;i style=&#x27;font-weight:normal;font-size:9px&#x27;&gt;bai_tumor_documentation, one row per procurement&lt;/i&gt;" tooltip="One row per procurement.&#10;Rolled up to per order counts, and the basis of 2nd Resections." id="n2"><mxCell style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=32;horizontalStack=0;resizeParent=0;collapsible=0;marginBottom=0;html=1;fontSize=12;rounded=1;strokeColor=#42535F;swimlaneFillColor=#FFFFFF;fillColor=#EAF0E4;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="280" height="122" as="geometry"/></mxCell></UserObject>
        <UserObject label="PK  name" tooltip="Procurement record id (unique per row)" id="n3"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n2"><mxGeometry y="32" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="FK  til_order_name" tooltip="Joins to ORDERS.order_request__til_order_name.&#10;An order can have SEVERAL procurement rows." id="n4"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n2"><mxGeometry y="56" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="tumor_tissue_pick_up_date" tooltip="Date of this procurement (0.1% null here)" id="n5"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n2"><mxGeometry y="80" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="&lt;b&gt;ORDERS&lt;/b&gt;&lt;br/&gt;&lt;i style=&#x27;font-weight:normal;font-size:9px&#x27;&gt;bai_list_of_orders, HUB, one row per TIL order&lt;/i&gt;" tooltip="The hub. Every metric starts here.&#10;One row per TIL order." id="n6"><mxCell style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=32;horizontalStack=0;resizeParent=0;collapsible=0;marginBottom=0;html=1;fontSize=12;rounded=1;strokeColor=#42535F;swimlaneFillColor=#FFFFFF;fillColor=#EAF0E4;" vertex="1" parent="1"><mxGeometry x="60" y="236" width="280" height="362" as="geometry"/></mxCell></UserObject>
        <UserObject label="PK  order_request__til_order_name" tooltip="Primary key. Join key to every child table." id="n7"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n6"><mxGeometry y="32" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="AK  coi_number" tooltip="Alternate order key" id="n8"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n6"><mxGeometry y="56" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="iovance_patient_id" tooltip="Patient key (a hash). One patient can hold several orders.&#10;Grain key for metrics 2, 6, 7 and 9." id="n9"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n6"><mxGeometry y="80" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="atc" tooltip="Treatment center, FREE TEXT.&#10;Normalized to center_key for the center mapping join." id="n10"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n6"><mxGeometry y="104" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="order_request__created_date" tooltip="Enrollment date (the metric 1 and 2 event date).&#10;Also defines the as-of date: as_of = MAX(created_date)." id="n11"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n6"><mxGeometry y="128" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="tumor_tissue_pick_up_date" tooltip="TTP date (27% null).&#10;Event date for metrics 3 to 7, 9 and 11." id="n12"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n6"><mxGeometry y="152" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="final_product_delivery_date" tooltip="Final product delivery (44% null).&#10;Event date for metric 8." id="n13"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n6"><mxGeometry y="176" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="fp_status" tooltip="Manufacturing status.&#10;Drives mfg_started (metric 9 denominator)." id="n14"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n6"><mxGeometry y="200" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="oos_status" tooltip="82% null. The value &#x27;Confirmed OOS&#x27; feeds oos_product (metric 8)." id="n15"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n6"><mxGeometry y="224" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="til_order_cancellation_reason" tooltip="58% null. Mapped to reason categories (health, choice, and so on).&#10;Unmapped values only warn." id="n16"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n6"><mxGeometry y="248" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="til_order_cancellation_reason_other" tooltip="Free text when reason = &#x27;Other&#x27;.&#10;Currently UNCOUNTED (open decision D6)." id="n17"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n6"><mxGeometry y="272" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="resection_rescheduled_" tooltip="Old metric 3 proxy flag (fired on 347 orders where the real&#10;7 day rule returns 83). Used only when the reschedule and&#10;cancellation tables are missing." id="n18"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n6"><mxGeometry y="296" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="patient_zip_code" tooltip="Dirty (junk placeholders); cleaned to patient_zip_clean:&#10;kept only where 1001 &lt;= zip &lt;= 99950, else null." id="n19"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n6"><mxGeometry y="320" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="&lt;b&gt;INFUSIONS&lt;/b&gt;&lt;br/&gt;&lt;i style=&#x27;font-weight:normal;font-size:9px&#x27;&gt;bai_infusion, one row per order (infused subset)&lt;/i&gt;" tooltip="One row per order, infused subset only.&#10;Matched one to one onto the order by til_order_name." id="n20"><mxCell style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=32;horizontalStack=0;resizeParent=0;collapsible=0;marginBottom=0;html=1;fontSize=12;rounded=1;strokeColor=#42535F;swimlaneFillColor=#FFFFFF;fillColor=#EAF0E4;" vertex="1" parent="1"><mxGeometry x="60" y="642" width="280" height="122" as="geometry"/></mxCell></UserObject>
        <UserObject label="PK  til_order_name" tooltip="Assumed unique, not enforced anywhere upstream (a documented risk)." id="n21"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n20"><mxGeometry y="32" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="infusion_date" tooltip="Event date for metrics 10, 12, 13 (10% null)." id="n22"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n20"><mxGeometry y="56" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="lifileucel_infused_" tooltip="&#x27;Yes&#x27; plus a non-null infusion_date sets amtagvi_infused (metric 10)." id="n23"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n20"><mxGeometry y="80" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="&lt;b&gt;CENTER MAPPING&lt;/b&gt;&lt;br/&gt;&lt;i style=&#x27;font-weight:normal;font-size:9px&#x27;&gt;veeva_komodo_atc_mapping, one row per center&lt;/i&gt;" tooltip="Deduplicated on center_key (keep first) before the left join.&#10;Unmatched centers get null region, territory and segment." id="n24"><mxCell style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=32;horizontalStack=0;resizeParent=0;collapsible=0;marginBottom=0;html=1;fontSize=12;rounded=1;strokeColor=#42535F;swimlaneFillColor=#FFFFFF;fillColor=#EAF0E4;" vertex="1" parent="1"><mxGeometry x="60" y="808" width="280" height="122" as="geometry"/></mxCell></UserObject>
        <UserObject label="PK  veeva_name" tooltip="Center name in Veeva.&#10;Joined via normalized center_key (fuzzy name match)." id="n25"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n24"><mxGeometry y="32" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="region / territory" tooltip="Field team geography attached to every order of the center." id="n26"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n24"><mxGeometry y="56" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="atc_segment" tooltip="Center segment; null for the ~6 of 85 unmatched centers." id="n27"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n24"><mxGeometry y="80" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="&lt;b&gt;RESCHEDULES&lt;/b&gt;&lt;br/&gt;&lt;i style=&#x27;font-weight:normal;font-size:9px&#x27;&gt;ltd_reschedules, one row per change to a booked TTP&lt;/i&gt;" tooltip="Metric 3 source, with CANCELLATIONS.&#10;Hourly snapshots, Aug 2024 to Jul 2026." id="n28"><mxCell style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=32;horizontalStack=0;resizeParent=0;collapsible=0;marginBottom=0;html=1;fontSize=12;rounded=1;strokeColor=#42535F;swimlaneFillColor=#FFFFFF;fillColor=#EAF0E4;" vertex="1" parent="1"><mxGeometry x="60" y="974" width="280" height="146" as="geometry"/></mxCell></UserObject>
        <UserObject label="FK  ORDER_ID" tooltip="Joins to order_request__til_order_name.&#10;Events whose order is missing are EXCLUDED (warned)." id="n29"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n28"><mxGeometry y="32" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="TTP_DATE_PREV" tooltip="The LOST slot date. The metric 3 event is dated here." id="n30"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n28"><mxGeometry y="56" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="SNAPSHOT_DATE_TIME_CURR" tooltip="When the change was recorded.&#10;days_notice = TTP_DATE_PREV minus this date." id="n31"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n28"><mxGeometry y="80" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="RESCHEDULED_CATEGORY" tooltip="&#x27;Postponed&#x27; or &#x27;Moved Up&#x27;. Both count today (open decision D1)." id="n32"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n28"><mxGeometry y="104" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="&lt;b&gt;CANCELLATIONS&lt;/b&gt;&lt;br/&gt;&lt;i style=&#x27;font-weight:normal;font-size:9px&#x27;&gt;ltd_cancellations, one row per cancelled TTP&lt;/i&gt;" tooltip="Metric 3 source.&#10;Blank direction means cancellation, always counts." id="n33"><mxCell style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=32;horizontalStack=0;resizeParent=0;collapsible=0;marginBottom=0;html=1;fontSize=12;rounded=1;strokeColor=#42535F;swimlaneFillColor=#FFFFFF;fillColor=#EAF0E4;" vertex="1" parent="1"><mxGeometry x="60" y="1164" width="280" height="146" as="geometry"/></mxCell></UserObject>
        <UserObject label="FK  ORDER_ID" tooltip="Joins to order_request__til_order_name." id="n34"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n33"><mxGeometry y="32" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="TTP_DATE" tooltip="A cancellation clears the date,&#10;so this single date IS the lost slot." id="n35"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n33"><mxGeometry y="56" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="SNAPSHOT_DATE_TIME_CURR" tooltip="When the cancellation was recorded." id="n36"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n33"><mxGeometry y="80" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="CANCELLATION_REASON" tooltip="Carries values never seen before&#10;(for example &#x27;ATC Switching Patients&#x27;). Warn only." id="n37"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n33"><mxGeometry y="104" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="&lt;b&gt;SLOTS  (optional)&lt;/b&gt;&lt;br/&gt;&lt;i style=&#x27;font-weight:normal;font-size:9px&#x27;&gt;bai_slot_data, one row per slot&lt;/i&gt;" tooltip="OPTIONAL diagnostic table.&#10;Produces has_slot only; drives NO metric." id="n38"><mxCell style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=32;horizontalStack=0;resizeParent=0;collapsible=0;marginBottom=0;html=1;fontSize=12;rounded=1;strokeColor=#42535F;swimlaneFillColor=#FFFFFF;fillColor=#EFF1F2;" vertex="1" parent="1"><mxGeometry x="60" y="1354" width="280" height="122" as="geometry"/></mxCell></UserObject>
        <UserObject label="PK  slot_name" tooltip="Slot id." id="n39"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n38"><mxGeometry y="32" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="FK  til_order_name" tooltip="36% null (unbooked slots)." id="n40"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n38"><mxGeometry y="56" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="slot_date" tooltip="Slot date." id="n41"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n38"><mxGeometry y="80" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="&lt;b&gt;ORDER MASTER&lt;/b&gt;&lt;br/&gt;&lt;i style=&#x27;font-weight:normal;font-size:9px&#x27;&gt;one row per order, fully enriched&lt;/i&gt;" tooltip="One row per order. Source tables are rolled up or looked up&#10;onto the order, never joined row to row, so the order count&#10;cannot multiply. Published as ppr_analysis." id="n42"><mxCell style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=32;horizontalStack=0;resizeParent=0;collapsible=0;marginBottom=0;html=1;fontSize=12;rounded=1;strokeColor=#42535F;swimlaneFillColor=#FFFFFF;fillColor=#DAE8FC;" vertex="1" parent="1"><mxGeometry x="400" y="70" width="280" height="650" as="geometry"/></mxCell></UserObject>
        <UserObject label="order_request__til_order_name" tooltip="Order key, carried through." id="n43"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n42"><mxGeometry y="32" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="iovance_patient_id" tooltip="Patient key, carried through." id="n44"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n42"><mxGeometry y="56" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="atc" tooltip="Center display name (free text, carried through)." id="n45"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n42"><mxGeometry y="80" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="center_key" tooltip="= normalize(atc): lowercase, legal suffixes (llc/inc/pllc/pc/pa/ltd)&#10;stripped, punctuation stripped, whitespace collapsed." id="n46"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n42"><mxGeometry y="104" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="region / territory / atc_segment" tooltip="From CENTER MAPPING via left join on center_key&#10;(mapping deduped keep first; unmatched orders keep nulls)." id="n47"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n42"><mxGeometry y="128" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="atc_tier" tooltip="Rank centers by COUNT(DISTINCT orders):&#10;New = first enrollment year &gt;= 2025 (proxy; bottom 12 fallback if none)&#10;rank &lt;= 10 is Top 10, rank 11 to 40 is Top 40, else Other.&#10;Re-ranked on every refresh." id="n48"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n42"><mxGeometry y="152" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="as_of" tooltip="= MAX(order_request__created_date), or an explicit override.&#10;Never the clock. Recorded with every refresh." id="n49"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n42"><mxGeometry y="176" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="enrollment_date" tooltip="= order_request__created_date (parsed, unparseable becomes null)." id="n50"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n42"><mxGeometry y="200" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="tumor_pickup_date" tooltip="= tumor_tissue_pick_up_date (parsed)." id="n51"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n42"><mxGeometry y="224" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="fp_delivery_date" tooltip="= final_product_delivery_date (parsed)." id="n52"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n42"><mxGeometry y="248" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="patient_zip_clean" tooltip="= numeric(patient_zip_code) kept only where&#10;1001 &lt;= zip &lt;= 99950, else null." id="n53"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n42"><mxGeometry y="272" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="tpf_count" tooltip="= COUNT of procurement rows per order (0 when absent)." id="n54"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n42"><mxGeometry y="296" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="has_tumor" tooltip="= tpf_count &gt; 0" id="n55"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n42"><mxGeometry y="320" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="has_slot" tooltip="= order appears in SLOTS (diagnostic only, drives no metric)." id="n56"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n42"><mxGeometry y="344" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="completed_ttp" tooltip="= tumor_pickup_date not null AND tumor_pickup_date &lt;= as_of" id="n57"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n42"><mxGeometry y="368" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="scheduled_ttp" tooltip="= tumor_pickup_date &gt; as_of&#10;Always disjoint from completed_ttp&#10;(ruling 2026-07-31: scheduled means still upcoming)." id="n58"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n42"><mxGeometry y="392" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="oos_product" tooltip="= (oos_status = &#x27;Confirmed OOS&#x27;)" id="n59"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n42"><mxGeometry y="416" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="mfg_started" tooltip="= fp_status IN {MFG Start, MFG End, REP Initiation, REP Scale Out,&#10;   Released for Shipment by QA, Shipment Ready, Courier Picked-Up FP,&#10;   Courier Delivered FP, FP CAH}&#10;The 5 starting material (SM) states are EXCLUDED&#10;(including them inflates the metric 9 denominator by about a third)." id="n60"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n42"><mxGeometry y="440" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="dropout_post_ttp_health" tooltip="= has_tumor AND reason IN health list:&#10;{Patient health progressed, Decline in Performance Status,&#10; Disease Progression, Brain Mets, Patient death, Transition to Hospice}" id="n61"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n42"><mxGeometry y="464" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="drop_after_mfg" tooltip="= mfg_started AND reason IN (health list + Patient Choice)&#10;NED/MRD deliberately excluded (patient responded)." id="n62"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n42"><mxGeometry y="488" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="amtagvi_infused" tooltip="= has infusion row AND lifileucel_infused_ = &#x27;Yes&#x27;&#10;  AND infusion_date not null" id="n63"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n42"><mxGeometry y="512" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="ttp_cancel_le7" tooltip="Old proxy flag from resection_rescheduled_.&#10;Used for metric 3 only when the reschedule and cancellation&#10;tables are missing." id="n64"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n42"><mxGeometry y="536" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="days_enroll_to_ttp" tooltip="= tumor_pickup_date minus enrollment_date (negative values become null)" id="n65"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n42"><mxGeometry y="560" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="days_ttp_to_infusion" tooltip="= infusion_date minus tumor_pickup_date (negative values become null)" id="n66"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n42"><mxGeometry y="584" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="days_delivery_to_infusion" tooltip="= infusion_date minus fp_delivery_date (negative values become null)" id="n67"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n42"><mxGeometry y="608" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="&lt;b&gt;LOST SLOT EVENTS&lt;/b&gt;&lt;br/&gt;&lt;i style=&#x27;font-weight:normal;font-size:9px&#x27;&gt;one row per counted short notice lost slot&lt;/i&gt;" tooltip="The counting rule for metric 3:&#10;an event counts when 0 &lt;= days_notice &lt;= 7.&#10;Every dropped row is counted and the totals must reconcile:&#10;never booked slot, negative notice (admin cleanup),&#10;more than 7 days notice, direction not counted.&#10;Published as ppr_cancellations." id="n68"><mxCell style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=32;horizontalStack=0;resizeParent=0;collapsible=0;marginBottom=0;html=1;fontSize=12;rounded=1;strokeColor=#42535F;swimlaneFillColor=#FFFFFF;fillColor=#DAE8FC;" vertex="1" parent="1"><mxGeometry x="400" y="800" width="280" height="242" as="geometry"/></mxCell></UserObject>
        <UserObject label="center / center_key / center_disp" tooltip="Center found by joining ORDER_ID to ORDER MASTER&#10;(the reschedule tables carry no center).&#10;Unmatched events EXCLUDED with a warning." id="n69"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n68"><mxGeometry y="32" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="order" tooltip="ORDER_ID of the order that lost the slot.&#10;Grain is EVENTS: one order losing two slots counts twice&#10;(open decision D2)." id="n70"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n68"><mxGeometry y="56" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="event_date" tooltip="= the LOST slot date (TTP_DATE_PREV / TTP_DATE),&#10;NOT the day the change was entered." id="n71"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n68"><mxGeometry y="80" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="recorded_on" tooltip="= SNAPSHOT_DATE_TIME_CURR cast to date." id="n72"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n68"><mxGeometry y="104" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="days_notice" tooltip="= event_date minus recorded_on" id="n73"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n68"><mxGeometry y="128" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="kind" tooltip="&#x27;rescheduled&#x27; or &#x27;cancelled&#x27; (by source table)." id="n74"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n68"><mxGeometry y="152" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="direction" tooltip="&#x27;Postponed&#x27; / &#x27;Moved Up&#x27; / blank (cancellation)." id="n75"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n68"><mxGeometry y="176" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="reason" tooltip="CANCELLATION_REASON, when present." id="n76"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n68"><mxGeometry y="200" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="&lt;b&gt;EVENTS&lt;/b&gt;&lt;br/&gt;&lt;i style=&#x27;font-weight:normal;font-size:9px&#x27;&gt;one row per metric event per period column&lt;/i&gt;" tooltip="The one dataset Tableau reads: Redshift table ppr.ppr_events,&#10;landed back by the Glue job (a hyper extract is also written&#10;as a byproduct). NO UNIQUE KEY BY DESIGN,&#10;identical rows are intentional, never deduplicate.&#10;Checked on every refresh: every cell must match an independent&#10;recomputation of all 13 metrics, and period columns plus Undated&#10;plus After as-of must add back to Launch to Date for additive&#10;measures. Patient distinct measures are non additive by design." id="n77"><mxCell style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=32;horizontalStack=0;resizeParent=0;collapsible=0;marginBottom=0;html=1;fontSize=12;rounded=1;strokeColor=#42535F;swimlaneFillColor=#FFFFFF;fillColor=#FFF2CC;" vertex="1" parent="1"><mxGeometry x="740" y="70" width="280" height="266" as="geometry"/></mxCell></UserObject>
        <UserObject label="center" tooltip="Center display name;&#10;benchmark rows are repeated per center." id="n78"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n77"><mxGeometry y="32" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="metric_group / metric / metric_order" tooltip="The 13 template metric names in their 4 groups." id="n79"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n77"><mxGeometry y="56" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="agg" tooltip="PER ROW AGGREGATION CONTRACT for Tableau:&#10;sum:      SUM(value)&#10;distinct: COUNTD(unit)&#10;avg:      MEDIAN(value)&#10;rate:     AVG(value) shown as a percent&#10;preagg:   display the string carried in unit" id="n80"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n77"><mxGeometry y="80" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="event_date" tooltip="The metric&#x27;s own event date; null means undated.&#10;Only &#x27;Selected window&#x27; rows respond to the date parameters." id="n81"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n77"><mxGeometry y="104" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="value" tooltip="1 per count event; day count for avg rows;&#10;0 or 1 per manufacturing start patient for rate." id="n82"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n77"><mxGeometry y="128" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="unit" tooltip="Patient id (distinct rows)&#10;or a pre-formatted display string (benchmark rows)." id="n83"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n77"><mxGeometry y="152" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="col_label / col_order" tooltip="The period column this copy belongs to:&#10;Launch to Date, 2024, 2025, 2026 YTD, Undated, After as-of,&#10;Top 10, Top 40, New, the four quarters, Selected window.&#10;Each event appears once per column it falls in.&#10;Top 10 / Top 40 / New hold the tier benchmark: the MEDIAN&#10;across tier member centers of launch to date values." id="n84"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n77"><mxGeometry y="176" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="col_group / col_group_order" tooltip="Block headers:&#10;This Center, YTD National Metrics, Quarterly ATC Metrics" id="n85"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n77"><mxGeometry y="200" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="cell_color" tooltip="Banding plus heat token.&#10;Heat only on the Launch to Date column." id="n86"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n77"><mxGeometry y="224" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="&lt;b&gt;METRIC DEFINITIONS  M1 TO M13&lt;/b&gt;&lt;br/&gt;&lt;i style=&#x27;font-weight:normal;font-size:9px&#x27;&gt;hover each measure for its exact formula&lt;/i&gt;" tooltip="The 13 template metrics in 4 groups:&#10;Patient Identification and Enrollment (M1 to M3)&#10;Tumor Tissue Procurement (M4 to M6)&#10;AMTAGVI Regimen (M7 to M10)&#10;AMTAGVI Treatment Timelines (M11 to M13)&#10;Patient distinct measures (M2, M6, M7) are non additive by design." id="n87"><mxCell style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=32;horizontalStack=0;resizeParent=0;collapsible=0;marginBottom=0;html=1;fontSize=12;rounded=1;strokeColor=#42535F;swimlaneFillColor=#FFFFFF;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="740" y="416" width="280" height="362" as="geometry"/></mxCell></UserObject>
        <UserObject label="M1   Enrollments in IovanceCares" tooltip="= COUNT(DISTINCT order_request__til_order_name)&#10;Event date: enrollment_date" id="n88"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n87"><mxGeometry y="32" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="M2   Patients Enrolled" tooltip="= COUNT(DISTINCT iovance_patient_id)&#10;Event date: enrollment_date&#10;NON ADDITIVE across periods (a patient can span years)." id="n89"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n87"><mxGeometry y="56" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="M3   TTPs Cancelled/Resched &lt;= 7d" tooltip="= COUNT of LOST SLOT EVENTS in the window&#10;(a proxy flag stands in only if the reschedule tables are missing)&#10;Event date: the lost slot date.&#10;Open decisions: direction (D1), event or order grain (D2)." id="n90"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n87"><mxGeometry y="80" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="M4   Completed TTPs" tooltip="= SUM(completed_ttp)&#10;Event date: tumor_pickup_date" id="n91"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n87"><mxGeometry y="104" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="M5   Scheduled TTPs" tooltip="= SUM(scheduled_ttp), meaning still upcoming&#10;Event date: tumor_pickup_date (future dates land in After as-of)" id="n92"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n87"><mxGeometry y="128" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="M6   2nd Resections" tooltip="= COUNT(DISTINCT patients with &gt;= 2 DISTINCT pickup dates)&#10;Event date: the second pickup&#10;NON ADDITIVE; known window edge case (1 cell in 3,309)." id="n93"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n87"><mxGeometry y="152" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="M7   Drop-outs post TTP (health)" tooltip="= COUNT(DISTINCT patients with dropout_post_ttp_health)&#10;Event date: tumor_pickup_date&#10;NON ADDITIVE." id="n94"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n87"><mxGeometry y="176" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="M8   OOS Products" tooltip="= SUM(oos_product)&#10;Event date: fp_delivery_date&#10;Caution: a confirmed OOS product often never ships, so the&#10;date is null and it lands in Undated." id="n95"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n87"><mxGeometry y="200" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="M9   Patient Progression Rate" tooltip="= COUNT(DISTINCT patients drop_after_mfg)&#10;  / COUNT(DISTINCT patients mfg_started)&#10;Null when the denominator is 0. Event date: tumor_pickup_date.&#10;Carries a known reconciliation exception." id="n96"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n87"><mxGeometry y="224" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="M10  AMTAGVI Infusions Performed" tooltip="= SUM(amtagvi_infused)&#10;Event date: infusion_date&#10;Future dated counted as performed, flagged for review." id="n97"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n87"><mxGeometry y="248" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="M11  Median Enrollment to TTP (days)" tooltip="= MEDIAN(days_enroll_to_ttp), 1 decimal, blanks ignored&#10;Event date: tumor_pickup_date&#10;Median or average is open decision D3." id="n98"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n87"><mxGeometry y="272" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="M12  Median TTP to Infusion (days)" tooltip="= MEDIAN(days_ttp_to_infusion), 1 decimal&#10;Event date: infusion_date" id="n99"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n87"><mxGeometry y="296" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="M13  Median Delivery to Infusion (days)" tooltip="= MEDIAN(days_delivery_to_infusion), 1 decimal&#10;Event date: infusion_date" id="n100"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n87"><mxGeometry y="320" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="&lt;b&gt;TABLEAU: P&amp;amp;PR Dashboard&lt;/b&gt;&lt;br/&gt;&lt;i style=&#x27;font-weight:normal;font-size:9px&#x27;&gt;parameters and calculated fields&lt;/i&gt;" tooltip="The workbook connects directly to ppr.ppr_events in Redshift&#10;and needs nothing else. Refresh only after the daily job&#10;succeeds. The production workbook still needs direct verification." id="n101"><mxCell style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=32;horizontalStack=0;resizeParent=0;collapsible=0;marginBottom=0;html=1;fontSize=12;rounded=1;strokeColor=#42535F;swimlaneFillColor=#FFFFFF;fillColor=#E1D5E7;" vertex="1" parent="1"><mxGeometry x="1080" y="70" width="280" height="194" as="geometry"/></mxCell></UserObject>
        <UserObject label="param   pCenter" tooltip="String parameter, the center selector." id="n102"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n101"><mxGeometry y="32" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="param   pStart / pEnd" tooltip="Date parameters, the custom window&#10;(defaults 2025-01-01 / 2026-05-05)." id="n103"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n101"><mxGeometry y="56" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="calc    Keep Center" tooltip="= [center] = [pCenter]&#10;Filter, keep True." id="n104"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n101"><mxGeometry y="80" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="calc    Keep Row" tooltip="= IF [col_label] = &#x27;Selected window&#x27;&#10;  THEN [event_date] &gt;= [pStart] AND [event_date] &lt;= [pEnd]&#10;  ELSE TRUE END&#10;Dates bite only on the live column;&#10;period columns pass through untouched." id="n105"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n101"><mxGeometry y="104" width="280" height="24" as="geometry"/></mxCell></UserObject>
        <UserObject label="calc    Result" tooltip="= IF ATTR([agg])=&#x27;sum&#x27;      THEN STR(INT(SUM([value])))&#10;  ELSEIF ATTR([agg])=&#x27;distinct&#x27; THEN STR(COUNTD([unit]))&#10;  ELSEIF ATTR([agg])=&#x27;avg&#x27;   THEN STR(ROUND(MEDIAN([value]),1))&#10;  ELSEIF ATTR([agg])=&#x27;rate&#x27;  THEN STR(ROUND(AVG([value])*100,1))+&#x27;%&#x27;&#10;  END" id="n106"><mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;whiteSpace=nowrap;html=1;fontSize=11;" vertex="1" parent="n101"><mxGeometry y="128" width="280" height="24" as="geometry"/></mxCell></UserObject>
